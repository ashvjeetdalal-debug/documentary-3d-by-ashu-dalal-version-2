# Auto detect text files and normalize line endings
* text=auto

# Scripts: ensure LF line endings across platforms
*.sh text eol=lf
*.py text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary media formats
*.png binary
*.jpg binary
*.jpeg binary
*.svg text
*.pdf binary
*.ttf binary
*.woff2 binary
*.glb binary
*.onnx binary
*.bin binary
