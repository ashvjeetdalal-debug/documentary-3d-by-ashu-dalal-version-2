{
  "name": "code-3d-video-project",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "doctor": "node tools/doctor.mjs --chrome --gpu",
    "selftest": "node tools/build.mjs --story story.selftest.json --scale 0.5 --out out/selftest.mp4 --chrome --gpu",
    "qa": "node tools/qa.mjs --chrome --gpu",
    "stills": "node tools/build.mjs --stills --chrome --gpu",
    "preview": "node tools/build.mjs --scale 0.5 --out out/preview.mp4 --chrome --gpu",
    "build": "node tools/build.mjs --chrome --gpu"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "three": "^0.170.0"
  }
}